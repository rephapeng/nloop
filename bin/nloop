#!/usr/bin/env python3
"""nloop CLI — drive the engine from the terminal (the bin/dtc pattern).

  nloop new "<goal>" "<verify_cmd>" [workdir]   queue a new loop (ad-hoc)
  nloop tasks                                   list the tasks in the registry
  nloop run <task> [k=v ...]                    trigger a task with a payload
  nloop ls [--task X] [--status X]              list runs + status + cost
  nloop show <run_id>                           run detail + iterations
  nloop stop <run_id>                           request a stop
  nloop schedules                               list schedules + status
  nloop trigger <schedule>                      run a schedule's pipeline right now
  nloop ask "<question>" [--role X]             one-shot Q&A (read-only, no server needed)
  nloop ws                                      list workspaces (tenants)

The server is read from config.yaml (the server section). Override: NLOOP_URL.
Workspace: NLOOP_WORKSPACE=jetorbit nloop ls  (empty = the primary workspace).
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)


def base_url() -> str:
    if os.environ.get("NLOOP_URL"):
        return os.environ["NLOOP_URL"].rstrip("/")
    from engine import config
    cfg = config.load(os.path.join(ROOT, "config.yaml"))
    host = cfg["server"]["host"]
    if host in ("0.0.0.0", "::"):
        host = "127.0.0.1"
    return f"http://{host}:{cfg['server']['port']}"


def api(method: str, path: str, body: dict | None = None):
    # Every request is scoped to a workspace when NLOOP_WORKSPACE is set; empty =
    # the primary workspace (the old behavior).
    ws = os.environ.get("NLOOP_WORKSPACE", "").strip()
    if ws and path.startswith("/api/"):
        path += ("&" if "?" in path else "?") + "workspace=" + urllib.parse.quote(ws)
    req = urllib.request.Request(
        base_url() + path, method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        print(f"HTTP {e.code}: {e.read().decode()[:500]}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"can't reach the server ({e.reason}) — is nloop running? check ./run.sh",
              file=sys.stderr)
        sys.exit(1)


def cmd_new(args: list[str]) -> None:
    if len(args) < 2:
        die('usage: nloop new "<goal>" "<verify_cmd>" [workdir]')
    body = {"goal": args[0], "verify_cmd": args[1]}
    if len(args) > 2:
        body["workdir"] = args[2]
    out = api("POST", "/api/loops", body)
    print(f"run {out['run_id']} queued  workdir={out['workdir']}")


def cmd_tasks(_args: list[str]) -> None:
    items = api("GET", "/api/tasks")
    if not items:
        print("(registry is empty — fill in `tasks:` in config.yaml or tasks/<id>.yaml)")
        return
    for t in items:
        req = ",".join(t.get("required") or []) or "-"
        last = t.get("last_run")
        tail = f"  last: {last['status']} ({last['id']})" if last else ""
        kind = "" if t.get("triggerable") else "  [built-in]"
        print(f"{t['id']:<20} payload: {req:<24} {t.get('name', '')}{kind}{tail}")


def cmd_run(args: list[str]) -> None:
    """nloop run <task> slot=pagi n=3 — values are parsed as JSON first (numbers/bools)."""
    if not args:
        die('usage: nloop run <task> [key=value ...]')
    task, payload = args[0], {}
    for pair in args[1:]:
        if "=" not in pair:
            die(f"payload must be key=value: {pair}")
        k, v = pair.split("=", 1)
        try:
            payload[k] = json.loads(v)
        except ValueError:
            payload[k] = v
    out = api("POST", f"/api/tasks/{task}/trigger", {"payload": payload})
    if out.get("deduped"):
        print(f"run {out['run_id']} is still active for key '{out['idempotency_key']}' "
              "— not creating a new run")
    else:
        print(f"run {out['run_id']} queued  task={task}  workdir={out['workdir']}")


def cmd_ls(args: list[str]) -> None:
    q = []
    for flag, key in (("--task", "task"), ("--status", "status")):
        if flag in args:
            i = args.index(flag)
            if i + 1 >= len(args):
                die(f"{flag} needs a value")
            q.append(f"{key}={args[i + 1]}")
    path = "/api/loops" + ("?" + "&".join(q) if q else "")
    for r in api("GET", path):
        goal = r["goal"].splitlines()[0][:60]
        task = f"[{r['task_id']}] " if r.get("task_id") else ""
        print(f"{r['id']}  {r['status']:<9}  it {r['iterations_done']}/{r['max_iterations']}"
              f"  ${r['cost_total']:.2f}  {task}{goal}")


def cmd_show(args: list[str]) -> None:
    if not args:
        die("usage: nloop show <run_id>")
    print(json.dumps(api("GET", f"/api/loops/{args[0]}"), indent=2, ensure_ascii=False))


def cmd_stop(args: list[str]) -> None:
    if not args:
        die("usage: nloop stop <run_id>")
    api("POST", f"/api/loops/{args[0]}/stop")
    print(f"stop requested for {args[0]}")


def cmd_schedules(_args: list[str]) -> None:
    scheds = api("GET", "/api/schedules")
    if not scheds:
        print("(no schedules in config.yaml)")
        return
    for name, s in scheds.items():
        when = s["at"] and f'at {s["at"]} UTC' or f'every {s["every"]}'
        active = f"  ACTIVE: {s['active_run']}" if s.get("active_run") else ""
        print(f"{name}  {when}  {s['steps']} step{active}")


def cmd_trigger(args: list[str]) -> None:
    if not args:
        die("usage: nloop trigger <schedule>")
    print(json.dumps(api("POST", f"/api/schedules/{args[0]}/trigger"), ensure_ascii=False))


def cmd_ask(args: list[str]) -> None:
    """One-shot read-only Q&A — spawns claude directly, no server/queue involved
    (the `dtc ask` pattern): role grounding + context_cmd still apply."""
    role = None
    if "--role" in args:
        i = args.index("--role")
        role = args[i + 1] if i + 1 < len(args) else None
        args = args[:i] + args[i + 2:]
    if not args:
        die('usage: nloop ask "<question>" [--role X]')

    import asyncio
    from engine import claude_cli, config, grounding
    cfg = config.load(os.path.join(ROOT, "config.yaml"))

    async def main() -> None:
        system_prompt = await grounding.build_system_prompt(cfg, role=role, workdir=".")
        res = await claude_cli.run(
            args[0], cwd=".",
            model=cfg["claude"].get("model"),
            max_turns=15,
            allowed_tools="Read,Grep,Glob,Bash",
            permission_mode="default",
            timeout_sec=600,
            system_prompt=system_prompt,
            lock_file=cfg["claude"].get("lock_file"),
        )
        if not res.ok:
            die(f"claude failed: {res.subtype} {res.stderr_tail[-300:]}")
        print(res.result_text)
        print(f"\n[cost ${res.cost_usd:.4f}, {res.num_turns} turns]", file=sys.stderr)

    asyncio.run(main())


def cmd_ws(_args: list[str]) -> None:
    """List workspaces. Pick one with the env var: NLOOP_WORKSPACE=jetorbit nloop ls"""
    body = api("GET", "/api/workspaces")
    active = os.environ.get("NLOOP_WORKSPACE", "").strip() or body["primary"]
    for w in body["workspaces"]:
        mark = "*" if w["name"] == active else " "
        tail = f"  {w['active']} active" if w.get("active") else ""
        print(f"{mark} {w['name']:<16} {w['tasks']} task · {w['schedules']} schedule"
              f" · {len(w['projects'])} project{tail}")


def die(msg: str) -> None:
    print(msg, file=sys.stderr)
    sys.exit(2)


COMMANDS = {"new": cmd_new, "ls": cmd_ls, "show": cmd_show, "stop": cmd_stop,
            "schedules": cmd_schedules, "trigger": cmd_trigger, "ask": cmd_ask,
            "tasks": cmd_tasks, "run": cmd_run, "ws": cmd_ws}


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "--help", "-h"):
        print(__doc__.strip())
        return
    fn = COMMANDS.get(sys.argv[1])
    if fn is None:
        die(f"unknown command: {sys.argv[1]} (try: nloop help)")
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
