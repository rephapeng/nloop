# Copy to .env (chmod 600). .env is gitignored — secrets must NEVER go in config.yaml.
# Telegram bot (also set telegram.enabled: true in config.yaml)
TELEGRAM_BOT_TOKEN=from-@BotFather
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# Auto-resolve Sentry issues once the fix ships (triggers.sentry.resolve: true)
# Create one at sentry.io: Settings > Auth Tokens, scope event:write + project:read
SENTRY_AUTH_TOKEN=sntrys_xxx
# Buffer.com integration (the promo-pagi/sore schedules + scripts/buffer_post.py)
# Create one at publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=xxx
# Queries MarginIn PostHog for the promo attribution report (scripts/promo_report.py)
# Personal API key (not a project key) — create one at app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=phx_xxx
